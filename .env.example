# ==========================================
# NibolbotWA Configuration
# ==========================================

API_URL=https://nibol.my.id:2235
PUBLIC_URL=https://nibol.my.id:2235
PORT=3000
BOT_SERVICE_URL=http://bot:3001
INTERNAL_TOKEN=your_internal_ipc_token_here
JWT_SECRET=your_jwt_secret_change_in_production

# Kredensial Administrator Web Panel
# CATATAN: Wajib ubah ADMIN_PASSWORD menjadi kata sandi yang kuat dan aman sebelum menjalankan di server!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_secure_password_in_production

# Konfigurasi Fitur .ythtml (Perekam Player HTML ke MP4)
YTHTML_MAX_SECONDS=60
YTHTML_MAX_MB=50

LOG_LEVEL=info
